{
  "manifest_version": 3,
  "name": "CCbd 伴宠",
  "version": "0.13.0",
  "description": "一只陪你逛推特、币安广场、OK星球的卡通伴宠，在你发帖、点赞的时候替你说句心里话，可自定义角色和装扮。",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "CCbd 伴宠 · 快捷开关",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://*.twitter.com/*",
        "https://*.binance.com/*",
        "https://binance.com/*",
        "https://*.okx.com/*",
        "https://okx.com/*",
        "https://*.okx.cab/*",
        "https://okx.cab/*",
        "https://*.okx.me/*",
        "https://okx.me/*",
        "https://*.ouyi.com/*",
        "https://ouyi.com/*"
      ],
      "js": [
        "shared.js",
        "stories.js",
        "content.js"
      ],
      "css": [
        "pet.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "sprites/*",
        "sprites/*/*",
        "scenes/*"
      ],
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://*.twitter.com/*",
        "https://*.binance.com/*",
        "https://binance.com/*",
        "https://*.okx.com/*",
        "https://okx.com/*",
        "https://*.okx.cab/*",
        "https://okx.cab/*",
        "https://*.okx.me/*",
        "https://okx.me/*",
        "https://*.ouyi.com/*",
        "https://ouyi.com/*"
      ]
    }
  ]
}