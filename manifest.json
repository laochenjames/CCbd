{
  "manifest_version": 3,
  "name": "X 桌宠",
  "version": "0.11.0",
  "description": "一只陪你逛推特、币安广场、OK星球的卡通小伙伴，可自定义角色和台词。",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://*.twitter.com/*",
        "https://*.binance.com/*",
        "https://binance.com/*",
        "https://*.okx.com/*",
        "https://okx.com/*"
      ],
      "js": [
        "shared.js",
        "stories.js",
        "content.js"
      ],
      "css": [
        "pet.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "key": "",
  "web_accessible_resources": [
    {
      "resources": [
        "sprites/*"
      ],
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://*.twitter.com/*",
        "https://*.binance.com/*",
        "https://binance.com/*",
        "https://*.okx.com/*",
        "https://okx.com/*"
      ]
    }
  ]
}